# Copy to .env and fill in. Never commit .env.
# Model names are configuration: override freely, nothing is hardcoded in code.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set to true in production/judging: serves only pre-generated content, zero live AI calls.
DEMO_MODE=false
